# Supabase Configuration
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Instagram API Configuration (Instagram Business Login)
# Get from: developers.facebook.com → Your App → Instagram → API setup with Instagram login
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_VERIFY_TOKEN=commentflow_verify_token_2026

# Security: 32-byte hex encryption key for Instagram Access Tokens (AES-256-GCM)
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=generate_a_new_64char_hex_key_here

# Application URL (use your Vercel/production URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
